# Ejemplo de mq-N.env para una máquina mq-N (sin secretos; se versiona).
# Copiar a mq-1.env / mq-2.env / mq-3.env y ajustar.
# mq-1 → 10.0.21.11 · mq-2 → 10.0.22.12 · mq-3 → 10.0.21.13

MQ_NODE_ID=1
MQ_PRIVATE_IP=10.0.21.11
# El mismo CLUSTER_ID en las tres máquinas (genera uno: kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=MOCK_CLUSTER_ID
KAFKA_CONTROLLER_QUORUM_VOTERS=1@10.0.21.11:9093,2@10.0.22.12:9093,3@10.0.21.13:9093
