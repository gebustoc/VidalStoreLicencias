# Ejemplo de mq-N.env para RabbitMQ (sin secretos; se versiona).
# mq-1 → nodo 1 · mq-2 → nodo 2
# Los secretos (RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS) van en
# /opt/vidalstore/secretos/rabbit.env, creado desde el Parameter Store.
MQ_NODE_ID=1
# Host que se usa en el nodename (rabbit@<host>). IP privada de la máquina.
MQ_NODE_ID_HOST=10.0.21.11
